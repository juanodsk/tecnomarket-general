NEXT_PUBLIC_APP_NAME=TecMarket
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
BACKEND_IMAGE=tecmarket-backend:local
APP_VERSION=0.0.1-SNAPSHOT
IMAGE_REVISION=local
IMAGE_BUILD_DATE=local

# Backend local profile and PostgreSQL
SPRING_PROFILES_ACTIVE=local
DATABASE_HOST=localhost
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/tecmarket_db
SPRING_DATASOURCE_USERNAME=tecmarket_user
SPRING_DATASOURCE_PASSWORD=tecmarket_password
SPRING_FLYWAY_USERNAME=tecmarket_user
SPRING_FLYWAY_PASSWORD=tecmarket_password

# Used by Docker compose for published port
FRONTEND_PORT=3000

# Backend security
JWT_SECRET=una_clave_super_segura_de_minimo_32_bytes
JWT_ISSUER=tecmarket
JWT_AUDIENCE=tecmarket-api
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
MAX_SESSIONS_PER_USER=5
SESSION_RETENTION_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_HTTP_LOCALHOST=false
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_REQUIRE_ORIGIN=false
RATE_LIMIT_REDIS_ENABLED=false
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=usa-un-secreto-largo-en-produccion
TRUSTED_PROXY_RANGES=127.0.0.1/32

# Pilot feature gates. Keep disabled until the corresponding go-live review.
FEATURE_MARKETPLACE_ENABLED=false
FEATURE_SUBSCRIPTIONS_ENABLED=false
FEATURE_COMMISSIONS_ENABLED=false
FEATURE_DIRECT_SALES_ENABLED=false

# Email verification
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
EMAIL_VERIFICATION_VERIFY_URL=http://localhost:8080/api/v1/auth/verify-email
EMAIL_VERIFICATION_FROM=no-reply@juanodsk.dev
PASSWORD_RESET_EXPIRATION_MINUTES=30
PASSWORD_RESET_URL=http://localhost:3000/restablecer-contrasena

# Resend
RESEND_API_KEY=reemplaza-con-tu-api-key-de-resend
RESEND_BASE_URL=https://api.resend.com

# MinIO / object storage
STORAGE_MINIO_ENABLED=false
STORAGE_MINIO_ENDPOINT=https://storage.example.com
STORAGE_MINIO_ACCESS_KEY=reemplaza-con-tu-access-key
STORAGE_MINIO_SECRET_KEY=reemplaza-con-tu-secret-key
STORAGE_MINIO_PUBLIC_BASE_URL=https://storage.example.com
STORAGE_MINIO_PRIVATE_DOWNLOAD_BASE_URL=https://evidence.example.com
STORAGE_MINIO_BUCKET_BUSINESS_ASSETS=business-assets
STORAGE_MINIO_BUCKET_SERVICE_IMAGES=service-images
STORAGE_MINIO_BUCKET_REPAIR_EVIDENCE=repair-order-evidence
STORAGE_MINIO_REPAIR_EVIDENCE_PUBLIC=false
STORAGE_MINIO_MAX_IMAGE_SIZE_BYTES=10485760
STORAGE_MINIO_MAX_IMAGE_WIDTH=8000
STORAGE_MINIO_MAX_IMAGE_HEIGHT=8000
STORAGE_MINIO_MAX_IMAGE_PIXELS=25000000
STORAGE_MINIO_MAX_SANITIZED_IMAGE_SIZE_BYTES=12582912
STORAGE_MINIO_PRESIGNED_EXPIRATION_MINUTES=10
STORAGE_EVIDENCE_RETENTION_DAYS=90
STORAGE_DELETION_CLEANUP_CRON="0 */5 * * * *"
STORAGE_DELETION_BATCH_SIZE=50
STORAGE_DELETION_MAX_ATTEMPTS=10
STORAGE_MAX_FILE_SIZE=10MB
STORAGE_MAX_REQUEST_SIZE=12MB

# Initial data. Enable both switches only for an intentional bootstrap.
SEED_ENABLED=false
SEED_PLATFORM_ADMIN_ENABLED=false
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_PLATFORM_ADMIN_DOCUMENT_TYPE_CODE=CC
SEED_PLATFORM_ADMIN_DOCUMENT_NUMBER=1000000001
SEED_PLATFORM_ADMIN_NAME=Platform
SEED_PLATFORM_ADMIN_SURNAME=Admin
SEED_PLATFORM_ADMIN_ADDRESS="Calle 1 # 1-01"
SEED_PLATFORM_ADMIN_PHONE=3000000000
SEED_PLATFORM_ADMIN_CITY=Medellin
